{
  "name": "law-office-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "برنامج إدارة مكتب المحاماة",
  "author": "Law Office Management System",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "node scripts/watch-main.js",
    "dev": "node scripts/dev.js",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.js",
    "build": "npm run build:renderer && npm run build:main",
    "build:dir": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis",
    "package": "npm run build && electron-builder --win nsis",
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "seed:small": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/seed.cjs --size=small",
    "seed:large": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/seed.cjs --size=large",
    "test": "npm run test:unit",
    "test:unit": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run tests/unit",
    "test:db": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run tests/db",
    "test:integration": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run tests/integration",
    "test:coverage": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run tests/unit --coverage",
    "test:offline": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run tests/unit/offline.test.ts",
    "test:print": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run tests/unit/print.test.ts",
    "test:security": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run tests/unit/security.test.ts",
    "test:perf": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run tests/perf",
    "test:install": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run tests/install",
    "test:e2e": "echo \"Playwright E2E suite prepared for Phase 9 packaging verification\"",
    "test:all": "npm run test:unit && npm run test:db && npm run test:integration && npm run test:offline && npm run test:security && npm run test:print && npm run test:perf && npm run test:install"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.8.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.14.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.64.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.lawoffice.app",
    "productName": "برنامج إدارة مكتب المحاماة",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "إدارة مكتب المحاماة",
      "uninstallDisplayName": "برنامج إدارة مكتب المحاماة",
      "runAfterFinish": false
    }
  }
}
